[Unit]
Description=Kubernetes Master Dashboard (Golang)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/k8s-dashboard
ExecStart=/opt/k8s-dashboard/k8s-dashboard-linux -port 8080 -kubeconfig /etc/kubernetes/admin.conf
Restart=always
RestartSec=5
Environment=PORT=8080

[Install]
WantedBy=multi-user.target

